# Copy to .env and fill in. The same BURN_TOKEN goes on every machine's agent + the widget.
BURN_TOKEN=change-me-to-a-long-random-string   # generate: openssl rand -hex 24
BURN_TZ=UTC                                     # your timezone (IANA), e.g. Asia/Kolkata — sets the day boundary
BURN_STALE_MIN=180                              # minutes without a push before a machine shows "inactive" (red)
